[Unit]
Description=Own a Taxi protocol worker
After=network-online.target ownataxi-backend.service
Wants=network-online.target

[Service]
Type=simple
User=ownataxi
Group=ownataxi
WorkingDirectory=/srv/ownataxi/current
EnvironmentFile=/etc/ownataxi/ownataxi.env
ExecStart=/usr/bin/node --import tsx scripts/run-worker.ts
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
