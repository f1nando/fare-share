[Unit]
Description=Own a Taxi backend
After=network-online.target mongod.service
Wants=network-online.target

[Service]
Type=simple
User=ownataxi
Group=ownataxi
WorkingDirectory=/srv/ownataxi/current
EnvironmentFile=/etc/ownataxi/ownataxi.env
ExecStart=/usr/bin/node --import tsx server/index.ts
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
