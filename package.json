{
  "name": "taxi-city-background",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "dev:server": "node --env-file-if-exists=.env --watch --import tsx server/index.ts",
    "server": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "server:typecheck": "tsc -p tsconfig.server.json",
    "test:backend": "node --import tsx --test tests/backend-voucher.test.ts tests/backend-worker.test.ts tests/backend-protocol-dashboard.test.ts tests/backend-setup.test.ts tests/backend-metadata.test.ts tests/backend-mint-assignments.test.ts tests/backend-jupiter.test.ts tests/backend-pump.test.ts tests/backend-admin.test.ts tests/backend-admin-auth.test.ts tests/backend-fee-admin.test.ts tests/backend-preflight.test.ts tests/backend-scenes.test.ts tests/backend-request-limits.test.ts tests/backend-public-data.test.ts tests/backend-trade.test.ts tests/backend-telegram-alerts.test.ts tests/backend-rehearsal-budget.test.ts tests/backend-mainnet-recovery-audit.test.ts tests/backend-rehearsal-assets.test.ts",
    "campaign:create": "node --env-file-if-exists=.env --import tsx scripts/create-trainee-campaign.ts",
    "worker": "node --env-file-if-exists=.env --import tsx scripts/run-worker.ts",
    "telegram:reset-admin": "node --env-file-if-exists=.env --import tsx scripts/reset-telegram-admin.ts",
    "protocol:initialize": "node --env-file-if-exists=.env --import tsx scripts/initialize-protocol.ts",
    "protocol:create-initialize-lookup": "node --env-file-if-exists=.env --import tsx scripts/create-initialize-lookup-table.ts",
    "protocol:addresses": "node --env-file-if-exists=.env --import tsx scripts/show-protocol-addresses.ts",
    "protocol:claim-lookup-addresses": "node --env-file-if-exists=.env scripts/show-claim-lookup-addresses.mjs",
    "protocol:create-claim-lookup": "node --env-file-if-exists=.env --import tsx scripts/create-claim-lookup-table.ts",
    "protocol:smoke-claim-many": "node --env-file-if-exists=.env --import tsx scripts/devnet-claim-many-smoke.ts",
    "protocol:audit-devnet-recovery": "node --env-file-if-exists=.env.devnet scripts/audit-devnet-recovery.mjs",
    "protocol:audit-mainnet-recovery": "node --env-file-if-exists=.env.mainnet-recovery --import tsx scripts/audit-mainnet-recovery.ts",
    "protocol:admin": "node --env-file-if-exists=.env --import tsx scripts/admin.ts",
    "protocol:benchmark": "node --env-file-if-exists=.env --import tsx scripts/benchmark-reward-batch.ts",
    "protocol:check-xstocks": "node --env-file-if-exists=.env --import tsx scripts/check-xstocks-liquidity.ts",
    "protocol:preflight": "node --env-file-if-exists=.env --import tsx scripts/preflight.ts",
    "rehearsal:preflight": "node --import tsx scripts/validate-rehearsal-manifest.ts",
    "admin:hash-password": "node --import tsx scripts/hash-admin-password.ts",
    "metadata:build": "node --env-file-if-exists=.env --import tsx scripts/build-nft-metadata.ts",
    "metadata:build-faretest": "node --env-file-if-exists=.env --import tsx scripts/build-faretest-metadata.ts",
    "rehearsal:prepare-assets": "node --import tsx scripts/prepare-rehearsal-assets.ts",
    "mint-assignments:generate": "node --import tsx scripts/generate-mint-assignments.ts",
    "build": "vite build",
    "build:city": "vite build --mode city",
    "models:build": "node scripts/build-collection.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --import tsx --test \"tests/*.test.js\" \"tests/*.test.ts\""
  },
  "dependencies": {
    "@solana-program/address-lookup-table": "^0.15.0",
    "@solana-program/system": "^0.15.0",
    "@solana-program/token": "^0.17.0",
    "@solana/kit": "^8.3.0",
    "@wallet-standard/app": "^1.1.1",
    "lightweight-charts": "^5.2.1",
    "mongodb": "^6.21.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.1.0"
  }
}
